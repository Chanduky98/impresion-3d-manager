# Local Development - SQLite
DATABASE_URL="file:./dev.db"

# For Production/Vercel - Turso (uncomment and replace with your actual values)
# DATABASE_URL="libsql://your-database-url.turso.io?authToken=your-auth-token"

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# For Vercel deployment:
# - Set NODE_ENV to "production"
# - Update NEXT_PUBLIC_APP_URL to your Vercel domain (e.g., https://your-app.vercel.app)
# - Update ALLOWED_ORIGINS to match your domain
# - Set DATABASE_URL to the Turso database URL
