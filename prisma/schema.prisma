// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Configuración global de la aplicación
model Settings {
  id                    String   @id @default(cuid())
  electricityCostPerKwh Float    @default(0.25) // Coste por kWh en euros
  currencySymbol        String   @default("€")
  defaultMarginPercent  Float    @default(30) // Margen de beneficio por defecto %
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Clientes
model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  zipCode   String?
  country   String?
  notes     String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Impresoras 3D
model Printer {
  id                  String        @id @default(cuid())
  name                String        @unique
  model               String
  manufacturer        String?
  serialNumber        String?
  description         String?
  printAreaX          Float         @default(200) // mm
  printAreaY          Float         @default(200) // mm
  printAreaZ          Float         @default(200) // mm
  nozzleTemperature   Int           @default(200) // Celsius
  bedTemperature      Int           @default(60) // Celsius
  powerConsumption    Float         @default(300) // Watts
  purchaseDate        DateTime?
  purchaseCost        Float?        // Coste de la impresora
  status              String        @default("active") // active, inactive, maintenance
  notes               String?
  printJobs           PrintJob[]
  maintenances        Maintenance[]
  usageLogs           UsageLog[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status])
}

// Materiales (filamentos, resinas, etc)
model Material {
  id              String     @id @default(cuid())
  name            String
  type            String     // PLA, ABS, PETG, Resina, etc
  color           String?
  diameter        Float?     // Diámetro del filamento en mm (1.75, 2.85, etc)
  supplier        String?
  costPerKg       Float      // Coste por kilogramo
  stockKg         Float?     // Stock disponible en kg (opcional)
  density         Float?     // Densidad g/cm3 para cálculos
  temperatureMin  Int?       // Temperatura mínima de impresión
  temperatureMax  Int?       // Temperatura máxima de impresión
  printSpeed      Int?       // Velocidad de impresión por defecto mm/s
  bedTemperature  Int?
  notes           String?
  pieces          Piece[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([type])
}

// Piezas/Modelos
model Piece {
  id                    String     @id @default(cuid())
  name                  String
  description           String?
  fileName              String?    // Nombre del archivo STL/OBJ
  fileSize              Float?     // MB
  weight                Float      // Gramos
  estimatedTime         Int        // Segundos
  materialId            String
  material              Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  status                String     @default("available") // available, in_progress, completed, discontinued
  customSellingPrice    Float?     // Precio final personalizado de venta (si es nulo, se calcula automáticamente)
  isPersonal            Boolean    @default(false) // true = pieza personal (precio 0, pero calcula valor)
  printJobs             PrintJob[]
  orderItems            OrderItem[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([materialId])
  @@index([status])
}

// Trabajos de impresión
model PrintJob {
  id                String     @id @default(cuid())
  name              String
  status            String     @default("pending") // pending, printing, paused, completed, failed
  printerId         String
  printer           Printer    @relation(fields: [printerId], references: [id], onDelete: Restrict)
  pieceId           String
  piece             Piece      @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  quantity          Int        @default(1)
  startTime         DateTime?
  endTime           DateTime?
  estimatedEndTime  DateTime?
  actualDuration    Int?       // Segundos reales
  success           Boolean    @default(false)
  notes             String?
  filePath          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([printerId])
  @@index([pieceId])
}

// Órdenes/Pedidos de clientes
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status          String      @default("pending") // pending, in_progress, completed, delivered, cancelled
  deliveryDate    DateTime?
  totalCost       Float       @default(0)
  totalPrice      Float       @default(0)
  marginPercent   Float       @default(30)
  notes           String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([clientId])
}

// Items de una orden
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pieceId   String
  piece     Piece    @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  quantity  Int      @default(1)
  unitCost  Float    @default(0)
  unitPrice Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([pieceId])
}

// Mantenimientos
model Maintenance {
  id           String   @id @default(cuid())
  printerId    String
  printer      Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  type         String   // cleaning, calibration, repair, nozzle_replacement, bed_replacement, etc
  description  String
  cost         Float    @default(0)
  status       String   @default("pending") // pending, in_progress, completed
  scheduledAt  DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([printerId])
  @@index([status])
}

// Registro de uso/tiempos
model UsageLog {
  id          String   @id @default(cuid())
  printerId   String
  printer     Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime?
  duration    Int?     // Segundos
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([printerId])
  @@index([startTime])
}

// Usuarios del sistema
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String    // Hash bcrypt
  role      String    @default("user") // admin, user
  active    Boolean   @default(true)
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
}

// Sesiones/Tokens
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}
